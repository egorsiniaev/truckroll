{
  "uid": "truckroll-fleet",
  "title": "Truckroll fleet",
  "tags": [
    "truckroll"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Uptime, last 24 h",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg_over_time((sum(max by (site, station, connector) (csms_connector_status{status=~\"Available|Preparing|Charging|SuspendedEV|SuspendedEVSE|Finishing\"}) * on(station) group_left() max by (station) (csms_station_connected)) / count(max by (site, station, connector) (csms_connector_status{status=\"Available\"})))[24h:1m])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 0.97
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "description": "Time-weighted: share of connector-time that was usable (station connected; connector free, preparing, charging, suspended or finishing). Faulted, unavailable and offline time is downtime."
    },
    {
      "id": 2,
      "type": "stat",
