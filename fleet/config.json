{
  "supervisionUrls": [
    "ws://toxiproxy:8001"
  ],
  "supervisionUrlDistribution": "round-robin",
  "log": {
    "file": "/dev/stdout",
    "errorFile": "/dev/stderr",
    "console": false,
    "rotate": false
  },
  "worker": {
    "processType": "workerSet",
    "elementsPerWorker": 10,
    "poolMinSize": 2,
    "poolMaxSize": 8
  },
  "uiServer": {
    "enabled": true,
    "type": "ws",
    "options": {
      "host": "::",
      "port": 8080
    },
    "accessPolicy": {
      "allowedHosts": [
        "simulator",
        "localhost",
        "127.0.0.1"
      ],
      "requireTlsForNonLoopback": false
    },
    "authentication": {
      "enabled": false
    }
  },
  "stationTemplateUrls": [
    {
      "file": "truckroll-ams-depot.station-template.json",
      "numberOfStations": 20
    },
    {
      "file": "truckroll-utr-retail.station-template.json",
      "numberOfStations": 12
    },
    {
      "file": "truckroll-a2-hub.station-template.json",
      "numberOfStations": 8
    },
    {
      "file": "truckroll-ehv-office.station-template.json",
      "numberOfStations": 10
    }
  ]
}
