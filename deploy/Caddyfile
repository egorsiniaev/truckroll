{$TRUCKROLL_HOST} {
	encode zstd gzip
	handle /grafana* {
		# Public and read-only (Viewer); a stray login header must not reach Grafana.
		reverse_proxy grafana:3000 {
			header_up -Authorization
		}
	}
	handle {
		reverse_proxy control:8000 {
			flush_interval -1
		}
	}
	# Page files change with every deploy: browsers must check (cheap, ETag) instead of mixing old and new modules.
	@page path / /*.html /js/* /*.css /*.svg
	header @page Cache-Control "no-cache"
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
}
