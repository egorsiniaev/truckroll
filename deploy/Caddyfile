{$TRUCKROLL_HOST} {
	encode zstd gzip
	handle /grafana* {
		# Public and read-only (Viewer); a stray login header must not reach Grafana.
		reverse_proxy grafana:3000 {
			header_up -Authorization
		}
	}
	# Anyone can watch and answer the agent's questions (approve / reject); the control panel and reports
	# need the owner's login.
	@write {
		path /api/*
		not path /api/decisions/*
		not method GET HEAD OPTIONS
	}
	handle @write {
		import /etc/caddy/secrets/auth.caddy
		reverse_proxy control:8000
	}
	handle {
		reverse_proxy control:8000 {
			flush_interval -1
		}
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
}
